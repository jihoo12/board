{
  "name": "inkboard",
  "version": "0.1.0",
  "description": "Collaborative whiteboard / note board on Cloudflare Workers",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite build && vite preview",
    "deploy": "vite build && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.worker.json --noEmit",
    "postinstall": "sh scripts/nixos-patch-workerd.sh || true"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jihoo12/board.git"
  },
  "license": "Apache-2.0",
  "type": "module",
  "bugs": {
    "url": "https://github.com/jihoo12/board/issues"
  },
  "homepage": "https://github.com/jihoo12/board#readme",
  "dependencies": {
    "mathjax": "^3.2.2",
    "perfect-freehand": "^1.2.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "roughjs": "^4.6.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.67.0",
    "@cloudflare/workers-types": "^5.20261103.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "wrangler": "^4.156.2"
  },
  "private": true
}
