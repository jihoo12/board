# 로컬 개발용 비밀값. `.dev.vars` 로 복사해서 쓰세요.
# GitHub OAuth App: https://github.com/settings/developers
#   callback URL: http://localhost:5173/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Google OAuth client (Web application): https://console.cloud.google.com/apis/credentials
#   redirect URI: http://localhost:5173/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# true 이면 OAuth 없이 이름만으로 로그인하는 "개발용 로그인"이 켜집니다. 프로덕션에서는 절대 켜지 마세요.
DEV_LOGIN=true
